[Unit]
Description=Sharaspace room bookings
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/sharaspace
Environment=SHARASPACE_BASE=/sharaspace/
ExecStart=/usr/bin/php -S 127.0.0.1:8103 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sharaspace
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
